// Prisma schema: generator (builds the TS client), datasource (which DB), models (tables).
// The connection URL lives in prisma7.config.ts, not here (Prisma 7).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  MEMBER
  ADMIN
}

enum JoinMode {
  REQUEST // host approves each request
  OPEN // auto-accept until full
}

enum SkillLevel {
  ANY
  BEGINNER
  INTERMEDIATE
  PRO
}

enum ActivityStatus {
  DRAFT
  OPEN
  FULL
  ONGOING
  COMPLETED
  CANCELLED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  LEFT
  REMOVED
}

enum NotificationType {
  JOIN_REQUEST
  REQUEST_APPROVED
  REQUEST_REJECTED
  ACTIVITY_UPDATED
  ACTIVITY_CANCELLED
  NEW_MESSAGE
  REMINDER
}

enum ReportTargetType {
  USER
  ACTIVITY
  MESSAGE
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

// ─── Users & auth (shape required by the Auth.js Prisma adapter) ────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  username  String?  @unique
  bio       String?
  ageRange  String? // e.g. "25-34"; optional, display only
  languages String[] @default([])
  role      Role     @default(MEMBER)

  // Home area. Exact coordinates are private; only homeAreaName is ever shown publicly.
  homeLatitude  Float?
  homeLongitude Float?
  // Computed by Postgres from the two columns above (see migration SQL). Read-only.
  homeLocation  Unsupported("geography(Point, 4326)")? @default(dbgenerated("\nCASE\n    WHEN ((\"homeLatitude\" IS NULL) OR (\"homeLongitude\" IS NULL)) THEN NULL::geography\n    ELSE (st_setsrid(st_makepoint(\"homeLongitude\", \"homeLatitude\"), 4326))::geography\nEND"))
  homeAreaName  String?

  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  interests        Interest[]
  hostedActivities Activity[]     @relation("HostedActivities")
  joinRequests     JoinRequest[]
  messages         Message[]
  notifications    Notification[]
  reports          Report[]       @relation("ReportsFiled")
  blocking         Block[]        @relation("Blocker")
  blockedBy        Block[]        @relation("Blocked")

  @@index([homeLocation], type: Gist)
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Categories & interests ─────────────────────────────────────────────────

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  icon      String // lucide-react icon name, e.g. "Dumbbell"
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  activities Activity[]
  interests  Interest[]
}

model Interest {
  userId     String
  categoryId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

// ─── Activities ─────────────────────────────────────────────────────────────

model Activity {
  id          String @id @default(cuid())
  hostId      String
  categoryId  String
  title       String
  description String

  startsAt        DateTime // stored in UTC
  durationMinutes Int
  // People the host wants to join, NOT counting the host.
  minPeople       Int
  maxPeople       Int

  joinMode       JoinMode       @default(REQUEST)
  skillLevel     SkillLevel     @default(ANY)
  status         ActivityStatus @default(DRAFT)
  preferenceNote String? // gender/age preference: displayed, never enforced
  whatToBring    String?
  costNote       String? // e.g. "Court fee ₹100 each" — informational only
  coverImage     String?

  // Venue. Exact coordinates/venue are private; public responses use areaName + rounded coords.
  venueName      String
  latitude       Float
  longitude      Float
  // Computed by Postgres from latitude/longitude (see migration SQL). Read-only.
  location       Unsupported("geography(Point, 4326)")? @default(dbgenerated("(st_setsrid(st_makepoint(longitude, latitude), 4326))::geography"))
  areaName       String
  showExactVenue Boolean                                @default(false) // reveal venue to accepted members only

  // Full-text search vector over title + description, computed by Postgres. Read-only.
  searchVector Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\"))"))

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host         User          @relation("HostedActivities", fields: [hostId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags         ActivityTag[]
  joinRequests JoinRequest[]
  messages     Message[]

  @@index([status, startsAt])
  @@index([hostId])
  @@index([categoryId])
  @@index([location], type: Gist)
  @@index([searchVector], type: Gin)
}

model ActivityTag {
  activityId String
  tag        String // lower-case, e.g. "badminton"

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([activityId, tag])
  @@index([tag])
}

model JoinRequest {
  id         String            @id @default(cuid())
  activityId String
  userId     String
  message    String?
  status     JoinRequestStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  decidedAt  DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([activityId, status])
  @@index([userId, status])
}

// ─── Chat & notifications ───────────────────────────────────────────────────

model Message {
  id         String   @id @default(cuid())
  activityId String
  senderId   String
  body       String
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([activityId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json // e.g. { activityId, title, actorName }
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ─── Safety ─────────────────────────────────────────────────────────────────

model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  details    String?
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  reporter User @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}
