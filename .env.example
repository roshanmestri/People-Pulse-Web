# Copy to .env and fill in. Never commit .env.
# Only variables prefixed with NEXT_PUBLIC_ are sent to the browser; everything else stays on the server.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://gathr:gathr@localhost:5432/gathr?schema=public"

# --- Better Auth (M2) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Google sign-in turns on automatically when both are set.
# Create at https://console.cloud.google.com/apis/credentials (OAuth client ID → Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Site ---
# Public base URL (used for link-preview images)
SITE_URL="http://localhost:3000"

# --- Production only (M9) — set these in Vercel → Settings → Environment Variables ---
# Neon's Vercel integration sets DATABASE_URL (pooled, for the app) and
# DATABASE_URL_UNPOOLED (direct, used by `prisma migrate deploy` and the seed).
# DATABASE_URL_UNPOOLED=""

# Vercel Blob: uploaded photos. Set automatically when you connect a (public) Blob store to the
# project: newer stores set BLOB_STORE_ID (auth via Vercel OIDC), older ones BLOB_READ_WRITE_TOKEN.
# Leave empty locally → photos are saved to .data/uploads.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# Resend: sign-in emails. Leave empty locally → magic links are printed in the terminal.
# EMAIL_FROM must use a domain you verified in Resend; without one, Resend's test sender
# only delivers to your own Resend account's email address.
RESEND_API_KEY=""
EMAIL_FROM="Gathr <onboarding@resend.dev>"
