# Copy to .env and fill in. Never commit .env.
# Only variables prefixed with NEXT_PUBLIC_ are sent to the browser; everything else stays on the server.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://gathr:gathr@localhost:5432/gathr?schema=public"

# --- Better Auth (M2) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Google sign-in turns on automatically when both are set.
# Create at https://console.cloud.google.com/apis/credentials (OAuth client ID → Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Site ---
# Public base URL (used for link-preview images)
SITE_URL="http://localhost:3000"
